(version 1)
# M3-ASSY-R12 (D-R12-03): four layers at JLCPCB, one assembled side, 0.3 / 0.45 mm vias only. R10 / R11 rules kept by name;
# the R12 floors follow JLC's multilayer capability and the cost study's no-surcharge via. Net classes and board setup are stage B's.
(rule "General copper to hole clearance"
  (constraint hole_clearance (min 0.25mm)))

# JLC multilayer 0.09 mm, plus 0.01 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 board floor: copper clearance"
  (constraint clearance (min 0.1mm)))

# JLC multilayer 0.09 mm, plus 0.01 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 board floor: track width"
  (constraint track_width (min 0.1mm)))

# JLC SMD pad to pad clearance (different nets) 0.15 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 JLC SMD pad to pad (different nets)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))

(rule "HRO M-12 internal SMD lands to locating holes"
  (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3') && ((A.Pad_Type == 'NPTH, mechanical' && B.Pad_Type == 'SMD') || (B.Pad_Type == 'NPTH, mechanical' && A.Pad_Type == 'SMD'))")
  (constraint hole_clearance (min 0.20mm)))

(rule "Small GND pad thermal relief"
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && A.Pad_Type == 'SMD'")
  (constraint thermal_relief_gap (min 0.25mm) (opt 0.25mm))
  (constraint thermal_spoke_width (min 0.3mm) (opt 0.3mm)))

(rule "Tag-Connect contact to foreign copper"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.508mm)))

(rule "R9 bare test pads to foreign copper"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('TP*')")
  (constraint clearance (min 1.0mm)))

(rule "JLC inner-layer PTH pad hole to copper"
  (layer inner)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (B.Type != 'Pad' || B.Pad_Type == 'Through-hole')")
  (constraint hole_clearance (min 0.55mm)))

(rule "JLC outer-layer PTH hole to track"
  (layer outer)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))

(rule "JLC pad hole to hole"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

# R10 D-R26-04 (1.0585 mm), default-deny: every net but GND, the gate pair and U1 NC balls (check_r12 S-10, m3_design/r12_fire.py)
(rule "S-10 Q124 gate nets to every raising net"
  (condition "(A.NetName == 'PYRO1_GATE' || A.NetName == 'PYRO1_GATE_N') && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'GND' && !(B.memberOfFootprint('U1') && B.NetName == 'unconnected-*')")
  (constraint clearance (min 1.06mm)))

# R10 D-R26-02 (1.040 mm), default-deny: every net but GND, the gate nets (their own rule) and PYRO1_IGN / _COLD / _CONT_MID; U1 NC balls count (R12F6-TRI-02; check_r12 S-10)
(rule "S-10 PYRO1_OUT to every net"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName != 'PYRO1_OUT' && B.NetName != 'GND' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_COLD' && B.NetName != 'PYRO1_CONT_MID' && B.NetName != 'PYRO1_IGN'")
  (constraint clearance (min 1.04mm)))

# R10 row 1 surface pairs 0.177 / 0.180 mm, R12 0.25 mm (check_r12 S-10)
(rule "S-10 PYRO1_OUT to GND"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName == 'GND' && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.25mm)))

# R12F5-TRI-01: J121.1 sat 0.101 mm from GND_pour_B (check_r12 S-10)
(rule "S-10 PYRO1_OUT to GND fills"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName == 'GND' && (A.Type == 'Zone' || B.Type == 'Zone') && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.5mm)))

# R134 overload: J121.2 sat 0.100 mm from GND_pour_B (round 5 verifier); U1 NC balls count (R12F6-TRI-02; check_r12 S-10)
(rule "S-10 PYRO1_IGN to every net"
  (condition "A.NetName == 'PYRO1_IGN' && B.NetName != 'PYRO1_IGN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_OUT' && B.NetName != 'RAW_ACT' && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.25mm)))

# R134 overload: every pour >= 0.5 mm from J121.2 (check_r12 S-10)
(rule "S-10 PYRO1_IGN to fills"
  (condition "A.NetName == 'PYRO1_IGN' && B.NetName != 'PYRO1_IGN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_OUT' && B.NetName != 'RAW_ACT' && (A.Type == 'Zone' || B.Type == 'Zone') && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.5mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_FET_S / ACT_GATE / RAW_ACT (check_r12 S-10)
(rule "S-10 BAT_IN (pack energy) to every net"
  (condition "A.NetName == 'BAT_IN' && B.NetName != 'BAT_IN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_FET_S' && B.NetName != 'ACT_GATE' && B.NetName != 'RAW_ACT'")
  (constraint clearance (min 1.04mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_GATE / BAT_IN / RAW_ACT (check_r12 S-10)
(rule "S-10 ACT_FET_S (pack energy) to every net"
  (condition "A.NetName == 'ACT_FET_S' && B.NetName != 'ACT_FET_S' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_GATE' && B.NetName != 'BAT_IN' && B.NetName != 'RAW_ACT'")
  (constraint clearance (min 1.04mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_FET_S / ACT_GATE / ARM1_SENSE_MID / BAT_IN / PYRO1_IGN (check_r12 S-10)
(rule "S-10 RAW_ACT (pack energy) to every net"
  (condition "A.NetName == 'RAW_ACT' && B.NetName != 'RAW_ACT' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_FET_S' && B.NetName != 'ACT_GATE' && B.NetName != 'ARM1_SENSE_MID' && B.NetName != 'BAT_IN' && B.NetName != 'PYRO1_IGN'")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 / R12F8-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply or an MCU pin (check_r12 S-10)
(rule "S-10 RAW_PROTECTED (I-5 rail) to every victim"
  (condition "A.NetName == 'RAW_PROTECTED' && (B.NetName == '3V3' || B.NetName == '3V3A' || B.NetName == 'ACT_EN' || B.NetName == 'ACT_EN_MCU' || B.NetName == 'ARM1_SENSE' || B.NetName == 'AUX_RX_MCU' || B.NetName == 'AUX_RX_WIRE' || B.NetName == 'AUX_TX_MCU' || B.NetName == 'AUX_TX_WIRE' || B.NetName == 'BAT_DVDT' || B.NetName == 'BAT_ENABLE' || B.NetName == 'BAT_FAULT_N' || B.NetName == 'BAT_ILIM' || B.NetName == 'BAT_OVLO' || B.NetName == 'BOOT0' || B.NetName == 'BUZZ_DRV' || B.NetName == 'BUZZ_G' || B.NetName == 'BUZZ_OUT' || B.NetName == 'CAM_5V_SENSE' || B.NetName == 'CAM_FB' || B.NetName == 'CAM_MCU_RX' || B.NetName == 'CAM_MCU_TX' || B.NetName == 'CAM_PWR_EN' || B.NetName == 'CAM_RX_WIRE' || B.NetName == 'CAM_TX_WIRE' || B.NetName == 'FB_3V3' || B.NetName == 'GPS_RX_MCU' || B.NetName == 'GPS_RX_WIRE' || B.NetName == 'GPS_TX_MCU' || B.NetName == 'GPS_TX_WIRE' || B.NetName == 'HG_CS' || B.NetName == 'HSE_IN' || B.NetName == 'HSE_OUT' || B.NetName == 'I2C1_SCL' || B.NetName == 'I2C1_SDA' || B.NetName == 'IMU_CS' || B.NetName == 'IMU_INT1' || B.NetName == 'LED_RED' || B.NetName == 'LED_RED_A' || B.NetName == 'LED_YEL' || B.NetName == 'LED_YEL_A' || B.NetName == 'NRST' || B.NetName == 'PORT_FB' || B.NetName == 'PORT_SENSE' || B.NetName == 'PYRO1_CONT' || B.NetName == 'QSPI_CLK' || B.NetName == 'QSPI_IO0' || B.NetName == 'QSPI_IO1' || B.NetName == 'QSPI_IO2' || B.NetName == 'QSPI_IO3' || B.NetName == 'QSPI_NCS' || B.NetName == 'RADIO_RX_MCU' || B.NetName == 'RADIO_RX_WIRE' || B.NetName == 'RADIO_TX_MCU' || B.NetName == 'RADIO_TX_WIRE' || B.NetName == 'SD_CS' || B.NetName == 'SD_MISO' || B.NetName == 'SD_MOSI' || B.NetName == 'SD_SCK' || B.NetName == 'SERVO1_MCU' || B.NetName == 'SERVO1_OUT' || B.NetName == 'SERVO2_MCU' || B.NetName == 'SERVO2_OUT' || B.NetName == 'SERVO3_MCU' || B.NetName == 'SERVO3_OUT' || B.NetName == 'SERVO4_MCU' || B.NetName == 'SERVO4_OUT' || B.NetName == 'SPI1_MISO' || B.NetName == 'SPI1_MOSI' || B.NetName == 'SPI1_SCK' || B.NetName == 'SWCLK' || B.NetName == 'SWDIO' || B.NetName == 'U9_FLT' || B.NetName == 'USB_DM' || B.NetName == 'USB_DP' || B.NetName == 'VBUS_SENSE' || B.NetName == 'VCAP1' || B.NetName == 'VCAP2' || B.NetName == 'VLOGIC_SENSE' || B.NetName == 'unconnected-(U*')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 / R12F8-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply or an MCU pin (check_r12 S-10)
(rule "S-10 VLOGIC (I-5 rail) to every victim"
  (condition "A.NetName == 'VLOGIC' && (B.NetName == '3V3' || B.NetName == '3V3A' || B.NetName == 'ACT_EN' || B.NetName == 'ACT_EN_MCU' || B.NetName == 'ARM1_SENSE' || B.NetName == 'AUX_RX_MCU' || B.NetName == 'AUX_RX_WIRE' || B.NetName == 'AUX_TX_MCU' || B.NetName == 'AUX_TX_WIRE' || B.NetName == 'BAT_DVDT' || B.NetName == 'BAT_ENABLE' || B.NetName == 'BAT_FAULT_N' || B.NetName == 'BAT_ILIM' || B.NetName == 'BAT_OVLO' || B.NetName == 'BOOT0' || B.NetName == 'BUZZ_DRV' || B.NetName == 'BUZZ_G' || B.NetName == 'BUZZ_OUT' || B.NetName == 'CAM_5V_SENSE' || B.NetName == 'CAM_EN' || B.NetName == 'CAM_FB' || B.NetName == 'CAM_MCU_RX' || B.NetName == 'CAM_MCU_TX' || B.NetName == 'CAM_PWR_EN' || B.NetName == 'CAM_RX_WIRE' || B.NetName == 'CAM_TX_WIRE' || B.NetName == 'FB_3V3' || B.NetName == 'GPS_RX_MCU' || B.NetName == 'GPS_RX_WIRE' || B.NetName == 'GPS_TX_MCU' || B.NetName == 'GPS_TX_WIRE' || B.NetName == 'HG_CS' || B.NetName == 'HSE_IN' || B.NetName == 'HSE_OUT' || B.NetName == 'I2C1_SCL' || B.NetName == 'I2C1_SDA' || B.NetName == 'IMU_CS' || B.NetName == 'IMU_INT1' || B.NetName == 'LED_RED' || B.NetName == 'LED_RED_A' || B.NetName == 'LED_YEL' || B.NetName == 'LED_YEL_A' || B.NetName == 'NRST' || B.NetName == 'PORT_FB' || B.NetName == 'PORT_SENSE' || B.NetName == 'PYRO1_CONT' || B.NetName == 'QSPI_CLK' || B.NetName == 'QSPI_IO0' || B.NetName == 'QSPI_IO1' || B.NetName == 'QSPI_IO2' || B.NetName == 'QSPI_IO3' || B.NetName == 'QSPI_NCS' || B.NetName == 'RADIO_RX_MCU' || B.NetName == 'RADIO_RX_WIRE' || B.NetName == 'RADIO_TX_MCU' || B.NetName == 'RADIO_TX_WIRE' || B.NetName == 'SD_CS' || B.NetName == 'SD_MISO' || B.NetName == 'SD_MOSI' || B.NetName == 'SD_SCK' || B.NetName == 'SERVO1_MCU' || B.NetName == 'SERVO1_OUT' || B.NetName == 'SERVO2_MCU' || B.NetName == 'SERVO2_OUT' || B.NetName == 'SERVO3_MCU' || B.NetName == 'SERVO3_OUT' || B.NetName == 'SERVO4_MCU' || B.NetName == 'SERVO4_OUT' || B.NetName == 'SPI1_MISO' || B.NetName == 'SPI1_MOSI' || B.NetName == 'SPI1_SCK' || B.NetName == 'SWCLK' || B.NetName == 'SWDIO' || B.NetName == 'U9_FLT' || B.NetName == 'USB_DM' || B.NetName == 'USB_DP' || B.NetName == 'VBUS_SENSE' || B.NetName == 'VCAP1' || B.NetName == 'VCAP2' || B.NetName == 'VLOGIC_SENSE' || B.NetName == 'unconnected-(U*')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 / R12F8-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply or an MCU pin (check_r12 S-10)
(rule "S-10 BST (I-5 rail) to every victim"
  (condition "A.NetName == 'BST' && (B.NetName == '3V3' || B.NetName == '3V3A' || B.NetName == 'ACT_EN' || B.NetName == 'ACT_EN_MCU' || B.NetName == 'ARM1_SENSE' || B.NetName == 'AUX_RX_MCU' || B.NetName == 'AUX_RX_WIRE' || B.NetName == 'AUX_TX_MCU' || B.NetName == 'AUX_TX_WIRE' || B.NetName == 'BAT_DVDT' || B.NetName == 'BAT_ENABLE' || B.NetName == 'BAT_FAULT_N' || B.NetName == 'BAT_ILIM' || B.NetName == 'BAT_OVLO' || B.NetName == 'BOOT0' || B.NetName == 'BUZZ_DRV' || B.NetName == 'BUZZ_G' || B.NetName == 'BUZZ_OUT' || B.NetName == 'CAM_5V_SENSE' || B.NetName == 'CAM_EN' || B.NetName == 'CAM_FB' || B.NetName == 'CAM_MCU_RX' || B.NetName == 'CAM_MCU_TX' || B.NetName == 'CAM_PWR_EN' || B.NetName == 'CAM_RX_WIRE' || B.NetName == 'CAM_TX_WIRE' || B.NetName == 'FB_3V3' || B.NetName == 'GPS_RX_MCU' || B.NetName == 'GPS_RX_WIRE' || B.NetName == 'GPS_TX_MCU' || B.NetName == 'GPS_TX_WIRE' || B.NetName == 'HG_CS' || B.NetName == 'HSE_IN' || B.NetName == 'HSE_OUT' || B.NetName == 'I2C1_SCL' || B.NetName == 'I2C1_SDA' || B.NetName == 'IMU_CS' || B.NetName == 'IMU_INT1' || B.NetName == 'LED_RED' || B.NetName == 'LED_RED_A' || B.NetName == 'LED_YEL' || B.NetName == 'LED_YEL_A' || B.NetName == 'NRST' || B.NetName == 'PORT_FB' || B.NetName == 'PORT_SENSE' || B.NetName == 'PYRO1_CONT' || B.NetName == 'QSPI_CLK' || B.NetName == 'QSPI_IO0' || B.NetName == 'QSPI_IO1' || B.NetName == 'QSPI_IO2' || B.NetName == 'QSPI_IO3' || B.NetName == 'QSPI_NCS' || B.NetName == 'RADIO_RX_MCU' || B.NetName == 'RADIO_RX_WIRE' || B.NetName == 'RADIO_TX_MCU' || B.NetName == 'RADIO_TX_WIRE' || B.NetName == 'SD_CS' || B.NetName == 'SD_MISO' || B.NetName == 'SD_MOSI' || B.NetName == 'SD_SCK' || B.NetName == 'SERVO1_MCU' || B.NetName == 'SERVO1_OUT' || B.NetName == 'SERVO2_MCU' || B.NetName == 'SERVO2_OUT' || B.NetName == 'SERVO3_MCU' || B.NetName == 'SERVO3_OUT' || B.NetName == 'SERVO4_MCU' || B.NetName == 'SERVO4_OUT' || B.NetName == 'SPI1_MISO' || B.NetName == 'SPI1_MOSI' || B.NetName == 'SPI1_SCK' || B.NetName == 'SWCLK' || B.NetName == 'SWDIO' || B.NetName == 'U9_FLT' || B.NetName == 'USB_DM' || B.NetName == 'USB_DP' || B.NetName == 'VBUS_SENSE' || B.NetName == 'VCAP1' || B.NetName == 'VCAP2' || B.NetName == 'VLOGIC_SENSE' || B.NetName == 'unconnected-(U*')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 / R12F8-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply or an MCU pin (check_r12 S-10)
(rule "S-10 SW_NODE (I-5 rail) to every victim"
  (condition "A.NetName == 'SW_NODE' && (B.NetName == '3V3' || B.NetName == '3V3A' || B.NetName == 'ACT_EN' || B.NetName == 'ACT_EN_MCU' || B.NetName == 'ARM1_SENSE' || B.NetName == 'AUX_RX_MCU' || B.NetName == 'AUX_RX_WIRE' || B.NetName == 'AUX_TX_MCU' || B.NetName == 'AUX_TX_WIRE' || B.NetName == 'BAT_DVDT' || B.NetName == 'BAT_ENABLE' || B.NetName == 'BAT_FAULT_N' || B.NetName == 'BAT_ILIM' || B.NetName == 'BAT_OVLO' || B.NetName == 'BOOT0' || B.NetName == 'BUZZ_DRV' || B.NetName == 'BUZZ_G' || B.NetName == 'BUZZ_OUT' || B.NetName == 'CAM_5V_SENSE' || B.NetName == 'CAM_EN' || B.NetName == 'CAM_FB' || B.NetName == 'CAM_MCU_RX' || B.NetName == 'CAM_MCU_TX' || B.NetName == 'CAM_PWR_EN' || B.NetName == 'CAM_RX_WIRE' || B.NetName == 'CAM_TX_WIRE' || B.NetName == 'FB_3V3' || B.NetName == 'GPS_RX_MCU' || B.NetName == 'GPS_RX_WIRE' || B.NetName == 'GPS_TX_MCU' || B.NetName == 'GPS_TX_WIRE' || B.NetName == 'HG_CS' || B.NetName == 'HSE_IN' || B.NetName == 'HSE_OUT' || B.NetName == 'I2C1_SCL' || B.NetName == 'I2C1_SDA' || B.NetName == 'IMU_CS' || B.NetName == 'IMU_INT1' || B.NetName == 'LED_RED' || B.NetName == 'LED_RED_A' || B.NetName == 'LED_YEL' || B.NetName == 'LED_YEL_A' || B.NetName == 'NRST' || B.NetName == 'PORT_FB' || B.NetName == 'PORT_SENSE' || B.NetName == 'PYRO1_CONT' || B.NetName == 'QSPI_CLK' || B.NetName == 'QSPI_IO0' || B.NetName == 'QSPI_IO1' || B.NetName == 'QSPI_IO2' || B.NetName == 'QSPI_IO3' || B.NetName == 'QSPI_NCS' || B.NetName == 'RADIO_RX_MCU' || B.NetName == 'RADIO_RX_WIRE' || B.NetName == 'RADIO_TX_MCU' || B.NetName == 'RADIO_TX_WIRE' || B.NetName == 'SD_CS' || B.NetName == 'SD_MISO' || B.NetName == 'SD_MOSI' || B.NetName == 'SD_SCK' || B.NetName == 'SERVO1_MCU' || B.NetName == 'SERVO1_OUT' || B.NetName == 'SERVO2_MCU' || B.NetName == 'SERVO2_OUT' || B.NetName == 'SERVO3_MCU' || B.NetName == 'SERVO3_OUT' || B.NetName == 'SERVO4_MCU' || B.NetName == 'SERVO4_OUT' || B.NetName == 'SPI1_MISO' || B.NetName == 'SPI1_MOSI' || B.NetName == 'SPI1_SCK' || B.NetName == 'SWCLK' || B.NetName == 'SWDIO' || B.NetName == 'U9_FLT' || B.NetName == 'USB_DM' || B.NetName == 'USB_DP' || B.NetName == 'VBUS_SENSE' || B.NetName == 'VCAP1' || B.NetName == 'VCAP2' || B.NetName == 'VLOGIC_SENSE' || B.NetName == 'unconnected-(U*')")
  (constraint clearance (min 1.04mm)))


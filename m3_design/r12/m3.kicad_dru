(version 1)
# M3-ASSY-R12 (D-R12-03): four layers at JLCPCB, one assembled side, 0.3 / 0.45 mm vias only. R10 / R11 rules kept by name;
# the R12 floors follow JLC's multilayer capability and the cost study's no-surcharge via. Net classes and board setup are stage B's.
(rule "General copper to hole clearance"
  (constraint hole_clearance (min 0.25mm)))

# JLC multilayer 0.09 mm, plus 0.01 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 board floor: copper clearance"
  (constraint clearance (min 0.1mm)))

# JLC multilayer 0.09 mm, plus 0.01 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 board floor: track width"
  (constraint track_width (min 0.1mm)))

# JLC SMD pad to pad clearance (different nets) 0.15 mm (https://jlcpcb.com/capabilities/pcb-capabilities)
(rule "R12 JLC SMD pad to pad (different nets)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))

(rule "HRO M-12 internal SMD lands to locating holes"
  (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3') && ((A.Pad_Type == 'NPTH, mechanical' && B.Pad_Type == 'SMD') || (B.Pad_Type == 'NPTH, mechanical' && A.Pad_Type == 'SMD'))")
  (constraint hole_clearance (min 0.20mm)))

(rule "Small GND pad thermal relief"
  (condition "A.Type == 'Pad' && A.NetName == 'GND' && A.Pad_Type == 'SMD'")
  (constraint thermal_relief_gap (min 0.25mm) (opt 0.25mm))
  (constraint thermal_spoke_width (min 0.3mm) (opt 0.3mm)))

(rule "Tag-Connect contact to foreign copper"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.508mm)))

(rule "R9 bare test pads to foreign copper"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('TP*')")
  (constraint clearance (min 1.0mm)))

(rule "JLC inner-layer PTH pad hole to copper"
  (layer inner)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && (B.Type != 'Pad' || B.Pad_Type == 'Through-hole')")
  (constraint hole_clearance (min 0.55mm)))

(rule "JLC outer-layer PTH hole to track"
  (layer outer)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))

(rule "JLC pad hole to hole"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

# R10 D-R26-04 (1.0585 mm), default-deny: every net but GND, the gate pair and U1 NC balls (check_r12 S-10, m3_design/r12_fire.py)
(rule "S-10 Q124 gate nets to every raising net"
  (condition "(A.NetName == 'PYRO1_GATE' || A.NetName == 'PYRO1_GATE_N') && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'GND' && !(B.memberOfFootprint('U1') && B.NetName == 'unconnected-*')")
  (constraint clearance (min 1.06mm)))

# R10 D-R26-02 (1.040 mm), default-deny: every net but GND, the gate nets (their own rule) and PYRO1_IGN / _COLD / _CONT_MID; U1 NC balls count (R12F6-TRI-02; check_r12 S-10)
(rule "S-10 PYRO1_OUT to every net"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName != 'PYRO1_OUT' && B.NetName != 'GND' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_COLD' && B.NetName != 'PYRO1_CONT_MID' && B.NetName != 'PYRO1_IGN'")
  (constraint clearance (min 1.04mm)))

# R10 row 1 surface pairs 0.177 / 0.180 mm, R12 0.25 mm (check_r12 S-10)
(rule "S-10 PYRO1_OUT to GND"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName == 'GND' && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.25mm)))

# R12F5-TRI-01: J121.1 sat 0.101 mm from GND_pour_B (check_r12 S-10)
(rule "S-10 PYRO1_OUT to GND fills"
  (condition "A.NetName == 'PYRO1_OUT' && B.NetName == 'GND' && (A.Type == 'Zone' || B.Type == 'Zone') && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.5mm)))

# R134 overload: J121.2 sat 0.100 mm from GND_pour_B (round 5 verifier); U1 NC balls count (R12F6-TRI-02; check_r12 S-10)
(rule "S-10 PYRO1_IGN to every net"
  (condition "A.NetName == 'PYRO1_IGN' && B.NetName != 'PYRO1_IGN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_OUT' && B.NetName != 'RAW_ACT' && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.25mm)))

# R134 overload: every pour >= 0.5 mm from J121.2 (check_r12 S-10)
(rule "S-10 PYRO1_IGN to fills"
  (condition "A.NetName == 'PYRO1_IGN' && B.NetName != 'PYRO1_IGN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'PYRO1_OUT' && B.NetName != 'RAW_ACT' && (A.Type == 'Zone' || B.Type == 'Zone') && !A.memberOfFootprint('TP*') && !B.memberOfFootprint('TP*') && !A.memberOfFootprint('J2') && !B.memberOfFootprint('J2')")
  (constraint clearance (min 0.5mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_FET_S / ACT_GATE / RAW_ACT (check_r12 S-10)
(rule "S-10 BAT_IN (pack energy) to every net"
  (condition "A.NetName == 'BAT_IN' && B.NetName != 'BAT_IN' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_FET_S' && B.NetName != 'ACT_GATE' && B.NetName != 'RAW_ACT'")
  (constraint clearance (min 1.04mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_GATE / BAT_IN / RAW_ACT (check_r12 S-10)
(rule "S-10 ACT_FET_S (pack energy) to every net"
  (condition "A.NetName == 'ACT_FET_S' && B.NetName != 'ACT_FET_S' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_GATE' && B.NetName != 'BAT_IN' && B.NetName != 'RAW_ACT'")
  (constraint clearance (min 1.04mm)))

# round 6 V-1 / V-2 (1.040 mm, R10 D-R26-02's figure), default-deny, fills too: every net but the gate nets and ACT_FET_S / ACT_GATE / ARM1_SENSE_MID / BAT_IN / PYRO1_IGN (check_r12 S-10)
(rule "S-10 RAW_ACT (pack energy) to every net"
  (condition "A.NetName == 'RAW_ACT' && B.NetName != 'RAW_ACT' && B.NetName != 'PYRO1_GATE' && B.NetName != 'PYRO1_GATE_N' && B.NetName != 'ACT_FET_S' && B.NetName != 'ACT_GATE' && B.NetName != 'ARM1_SENSE_MID' && B.NetName != 'BAT_IN' && B.NetName != 'PYRO1_IGN'")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 RAW_PROTECTED (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'RAW_PROTECTED' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 VLOGIC (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'VLOGIC' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 BST (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'BST' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 SW_NODE (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'SW_NODE' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 CAM_BST (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'CAM_BST' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 CAM_SW (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'CAM_SW' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 PORT_BST (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'PORT_BST' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (1.040 mm, pack voltage behind U9, D-R12-137's PACK_MIN): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 PORT_SW (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'PORT_SW' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 1.04mm)))

# R12F7-TRI-01 FMEA I-5 (0.300 mm, port voltage, R10 owner row 1's figure): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 CAM_5V (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'CAM_5V' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 0.30mm)))

# R12F7-TRI-01 FMEA I-5 (0.300 mm, port voltage, R10 owner row 1's figure): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 PORT_4V8 (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'PORT_4V8' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 0.30mm)))

# R12F7-TRI-01 FMEA I-5 (0.300 mm, port voltage, R10 owner row 1's figure): a bridge puts the rail on the MCU supply (check_r12 S-10)
(rule "S-10 VBUS (I-5 rail) to 3V3 / 3V3A"
  (condition "A.NetName == 'VBUS' && (B.NetName == '3V3' || B.NetName == '3V3A')")
  (constraint clearance (min 0.30mm)))

# measured floor 0.731 mm, reason D-R11-23 (check_r12 S-10, m3_design/r12_fire.py)
(rule "S-10 exception (D-R11-23): U1.C3 to U1.B2 on F.Cu"
  (layer "F.Cu")
  (condition "A.NetName == 'PYRO1_GATE_N' && A.memberOfFootprint('U1') && A.Pad_Number == 'C3' && B.NetName == '3V3' && B.memberOfFootprint('U1') && B.Pad_Number == 'B2'")
  (constraint clearance (min 0.731mm)))

# measured floor 0.731 mm, reason D-R11-23 (check_r12 S-10, m3_design/r12_fire.py)
(rule "S-10 exception (D-R11-23): U1.C3 to U1.D2 on F.Cu"

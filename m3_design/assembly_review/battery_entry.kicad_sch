		(uuid 2f29f6be-957e-544f-a4b7-fc7e5bf2c192))
	(text "J1.3--4: external dry contact. Closed = battery enabled; open/disconnected = OFF. USB remains independent."
		(at 20.32 236.22 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid f7f7dd47-9f13-5b5d-be20-9447dbc24542))
	(text "R80 precedes the contact and limits wire-fault current. This is a power-enable contact, not a physical main-current break."
		(at 20.32 242.57 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid f9d74294-ef18-5f83-9734-c75b251d80c3))
	(text "U9: TPS259470L active current limiting then thermal latch; ITIMER/AUXOFF deliberately NC."
		(at 20.32 248.92 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 134d7336-70f4-5fc4-8fca-4d3f4a2112d0))
	(text "Reverse battery: R80/R82 limit EN/OV input injection below10uA; C80 and D8 are nonpolar."
		(at 20.32 255.26999999999998 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid aabb3c1e-c2aa-5f7e-a714-26c7d9df9712))
	(text "Input supply must be fused/current-limited externally. Board copper before U9 is not protected by its current limit."
		(at 20.32 261.62 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 9e8e7e55-3791-5b37-8606-55fb80fa3a7a))
	(text "Qualified source wiring, interruption ratings, hot-plug waveforms and fault coordination remain bench release gates."
		(at 20.32 267.97 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid fba9f089-baf2-5062-a3b4-b15c1fe94b44))
	(text "Power rail serves core/camera, not servo motor current. TP/FAULT readings require an independent voltage measurement."
		(at 20.32 274.32 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 02872c82-4632-5f02-bd4a-10d1087dd53e))

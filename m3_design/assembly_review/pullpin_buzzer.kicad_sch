	(text "14 | Buzzer; AUD-4 removes J123, R160/R161, C160 and D122. PC13 U1.7 is NC/analog, with no pull-pin or EXTI13."
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid c7940a10-f64f-55f2-aab3-b53d686344da))
	(text "LS120 MLT-5020: pad1 positive, pad2 negative, pad3 isolated mechanical tab. Huaneng 2021-05-27 drawing; body5.0 +/-0.3 mm, height2.0 +/-0.2 mm."
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid f2a45cb8-e38e-5cce-9114-38af4efcf313))
	(text "BUZZ_DRV = PC14 U1.8 (R10); R162 1k and R163 10k retain the gate network. Use4kHz,50% duty GPIO software toggle; backup-domain GPIO <=2MHz. Never drive the coil with DC."
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 164aed60-4833-53fe-a6d2-64e8794085a6))
	(text "Keep LSEON=0 and do not assign RTC/clock outputs to PC14; VBAT=3V3, so backup-domain settings survive NRST. Buzzer and servo neutral behavior remain bench qualifications."
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 433b0ad4-b6fb-5542-ba7d-f8bc66b057c9))

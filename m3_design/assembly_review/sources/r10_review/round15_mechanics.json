    {
      "id": "R15-MEC-01",
      "severity": "Minor",
      "status": "active-new",
      "title": "U4 pad-to-pad GND straps under the package need a specific maker-guidance disposition",
      "evidence": [
        {
          "file": "m3_design/assembly_review/m3.kicad_pcb",
          "line": 50090,
          "layer": "B.Cu",
          "coordinates_mm": [
            [
              18.21,
              45.65
            ],
            [
              18.21,
              45.9
            ],
            [
              18.21,
              46.15
            ],
            [
              19.6,
              45.9
            ]
          ],
          "measured_value": "0.20mm GND strap connects U4.2/U4.3 along the pad row, with a midpoint branch to the GND via. At(18.21,45.9) it is inside the nominal3.00x2.50mm body but outside either0.575x0.350mm pad; the open land-to-land interval is0.150mm."
        },
        {
          "file": "m3_design/assembly_review/m3.kicad_pcb",
          "line": 50314,
          "layer": "B.Cu",
          "coordinates_mm": [
            [
              16.5,
              46.86
            ],
            [
              16.75,
              46.86
            ],
            [
              17,
              46.86
            ],
            [
              16.75,
              47.6
            ]
          ],
          "measured_value": "U4.6/U4.7 share another0.20mm strap under the nominal body between their lands."
        },
        {
          "source": "ST TN1383 Rev1, August2023",
          "pages": [
            7,
            8,
            9
          ],
          "url": "https://www.st.com/resource/en/technical_note/tn1383-pcb-design-guidelines-for-mems-sensors-stmicroelectronics.pdf",
          "measured_value": "Sections3.2-3.5 advise outward component-side escapes and no routing beneath the MEMS package, to reduce stress. Applying that guidance to the pad-row straps is a layout-guidance interpretation, not a measured sensor error.",
          "figures": {
            "page8": "Figure5",
            "page9": "Figure7"
          },
          "source_wording": "p7: All traces should flow outside the component; p8: Never place any routing or via on the top side under the device",
          "face_interpretation": "TN1383 illustrates top-mounted MEMS; for bottom-mounted U4 the component-side guidance applies to B.Cu."
        },
        {
          "file": "tools/check_r10.py",
          "line": 1883,
          "measured_value": "M-7 passes. Its inherited MEMS exclusion checks vias/fill and an inset interior; it is not a certification that all component-side routing lies outside the package."
        }
      ],
      "severity_basis": "A specific inherited routing-guidance residual, not demonstrated bias/function loss, an AGENTS section2 violation, or a new numerical design rule. General thermal/vibration qualification is already disclosed; this finding adds the actual unlisted geometry.",
      "concrete_fix": "Record these exact GND straps as a retained stress-guidance deviation and include them in sensor zero/bias/temperature/vibration first-article evaluation. Alternatively, qualify generator-only outward pad escapes and join the GND pads outside the package, preserving lands, fast references and clearances; do not claim a DRC-clean alternative without actual checks. A GND-only outward redraw is not prequalified low risk: actual outer-copper availability, via-to-signal spacing, reference antipads and sensor stress must be checked. No such alternative was executed in this lens."
    },

  "source_policy": {
    "native_subset": "One mm/absolute4.6 header pair before apertures/operations; dark native polarity; pad flashes, aperture definitions/macros and attributes; terminal M02.",
    "legacy_image_controls": "Only exact neutral IR/MI/OF/SF defaults accepted. Decimal equality avoids rounding a tiny non-default to a default.",
    "AS_IP": "ASAXBY and IPPOS accepted; non-default AS/IP rejected as project policy.",
    "plain_state": "G71/G90 confirm mm/absolute and M01 has no effect; unsupported units/notation/stops, unknown commands and commands after M02 reject.",
    "metadata": "G04, IN/LN and native TF/TA/TO/TD remain valid. Named metadata deletion clears component identity only for TD.C or TD-all.",
    "representation": "Commands parsed at Gerber boundaries, including compact files and complete macro blocks; line breaks do not define semantics.",
    "modern_transforms": "Prior LPC/LM/LR/LS/SR/AB rejection remains.",
    "geometry": "Native margins, aperture geometry, split EP windows, dry/manual policy and1um comparison unchanged; no coverage-percentage or stencil-volume rule."
  },
  "primary_reference": {
    "url": "https://www.ucamco.com/files/downloads/file_en/554/gerber-layer-format-specification-revision-2026-05_en.pdf",
    "sha256": "ac9e9899f573d69e472b2112f1ae879c70f6cd13e17db41a1c885caf69961662",
    "revision": "2026.05",
    "pages": [
      186,

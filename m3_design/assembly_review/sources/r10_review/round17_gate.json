  "findings": [
    {
      "id": "R17-GATE-01",
      "severity": "Minor",
      "status": "new_active",
      "title": "Missing canonical fabrication manifest silently disables its complete-gate check",
      "class": "prospective complete-gate artifact-completeness escape; target package is intact",
      "evidence": [
        {
          "file": "tools/check.sh",
          "line": 59,
          "observation": "Only an existing manifest enters the verification branch; there is no absent-manifest failure or diagnostic at lines54-66."
        },
        {
          "file": "tools/check_r10.py",
          "line": 1498,
          "observation": "The normal check.sh S-4 run receives neither --bom nor --cpl; it checks native/schematic fitting, leaving actual output binding to the manifest stage."
        },
        {
          "file": "docs/REQUIREMENTS.md",
          "section": "R10 acceptance",
          "observation": "R10 acceptance separately requires regenerated fabrication outputs bound to the board."
        },
        {
          "probe": ".supervisor/r17_gate_probe/complete_gate_receipt.json",
          "observation": "Copied all1966 frozen files, including project/rules/libs and the canonical ROOT/BOARD relationship. Unchanged complete gate exits0 and actually checks all5manifest outputs. After deleting only fab/m3_fab_manifest.json, complete gate again exits0 with no manifest-stage output. All1965 remaining files still equal the frozen inputs; PCB SHA is unchanged.",
          "positive_exit": 0,
          "missing_manifest_exit": 0,
          "positive_log_sha256": "1d91ae1798d3d343dbbe9fe963c057743151b7371cb550fd9bcfc06eb2a8ba07",
          "negative_log_sha256": "8d04c2792abde99f2e6555e951d7959dc0ac8653f81127df3150b97293d23dcc"
        },
        {
          "probe": ".supervisor/r17_gate_probe/saved_controls.json",
          "observation": "Restoring the original manifest validates5outputs; appending bytes to only the copied bottom assemblyPDF is rejected by verify_manifest. This control is focused, not a third complete gate."
        }
      ],
      "effect": "Deletion or omission of required binding evidence can receive a zero complete board-gate result. No corrupted production output or actual target defect is claimed: target manifest is present and all five outputs match.",
      "concrete_fix": "For canonical repository-board full checks, require the fabrication manifest unless the explicit documented build-stage mode applies; invoke its verifier and fail closed on absence. Add a canonical missing-manifest regression to test_check_shell. Preserve noncanonical board-copy behavior and actual fabrication checks. No PCB, placement, routing or circuit-generator edit is needed."
    }
  ],

	(text "15 | Telemetry radio and GPS (R6); 5 V power, 3.3 V UART logic"
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid ce6b6f56-25fc-54f8-8b21-426a5567afae))
	(text "U16 limits branch input to 0.458-0.523 A; U15 R194=66.5k limits harness output to 351-449 mA including resistor tolerance. U9 R84 = 750R, 3.956-4.845 A."
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 9b91bab2-34d6-59a4-a3f7-5d44612fc32a))
	(text "U14 AP63301: (R190||R206)=150k over R191=30k, 4.8 V nominal; DC 4.674-4.930 V before ripple. GPS max5.0V: verify startup and TX peaks."
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid a975d4bb-907f-534a-8291-bf4a328757f3))
	(text "R193 holds U16/U14 off in reset; R205 pulls wired open-drain fault to 3V3. M0/M1 have external reset pull-downs."
		(at 20.32 35.56 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 681127ff-aaec-551d-b389-e25e9c862665))
	(text "E22-900T22D 2026 manual: 100-140 mA TX at 22 dBm; >=3.3 V for rated RF power. GPS current and simultaneous startup require measurement."
		(at 20.32 40.64 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 1c5e78f9-edc7-5b9e-b5e5-b86cc93ee2e8))
	(text "PC6/PC7 USART6; PC8 M0, PC9 M1, PA8 AUX. PA9/PA10 USART1 GPS; disconnect GPS for ROM bootloader use."
		(at 20.32 45.72 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 8339cca7-2f36-5f85-813a-d71e1e28cf96))
	(text "1k and SRV05-4 on all seven harness signals. J131 pins: 1=5V, 2=GND, 3=module TX, 4=module RX. Match harness pin numbers."
		(at 20.32 50.8 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 23f33ae2-c1b8-5896-bb7f-e2f7e843fbde))
	(text "At 6 V input, 4.93 V output and assumed 85% efficiency, 449 mA output requires 434 mA < U16 458 mA minimum."
		(at 20.32 55.88 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 64df7afa-baf6-5ea7-b344-b018516490e5))
	(text "Radio commands cannot arm or fire. ARM is the physical J124 link; fire remains the local flight-control decision."
		(at 20.32 60.96 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 19684c0d-d69a-5f8d-b05f-b608c140f006))

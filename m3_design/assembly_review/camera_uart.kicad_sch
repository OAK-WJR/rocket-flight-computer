	(text "PB10/pin46 USART3_TX and PB11/pin47 USART3_RX use AF7. PC13/pin7 controls OE as GPIO."
		(at 20.32 231.14 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid a963204a-4bd7-500f-b196-bac03401f8cd))
	(text "U12 A-port=MCU3V3. B-port=U13 camera-derived3V3. Never substitute CAM5V for VCCB."
		(at 20.32 237.48999999999998 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid fa416378-2418-5fb7-bcd6-1b30d9250d57))
	(text "Reset: R102 holds OE LOW. Set TX idle HIGH before OE; disable OE before power-down."
		(at 20.32 243.83999999999997 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 0c0538bb-6744-570a-a30d-55b4256021a5))
	(text "U13 EN is internally biased: leave pin3 OPEN, not tied to IN. Pin4 is NC."
		(at 20.32 250.19 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid d60eff85-2b73-5251-b7d2-e77de7e4ff58))
	(text "UART is 3.3V, not RS232. TXU input operating range0..5.5V is not a cable battery-short rating."
		(at 20.32 256.53999999999996 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid 43105498-380f-5fde-b1ac-de66d5c0f781))
	(text "Camera VIH/VIL/VOH/VOL and timing remain unmeasured. Verify at TP75/76/90 before qualification."
		(at 20.32 262.89 0)
		(effects
			(font
				(size 1.05 1.05))
			(justify left))
		(uuid a90e40a7-675a-5694-ad5d-5626518d190c))

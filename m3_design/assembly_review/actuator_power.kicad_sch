	(text "11 | Actuator power switch"
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2.54 2.54))
			(justify left))
		(uuid ed417ce0-96d9-53db-a75b-03be6e545f03))
	(text "Second, high-current battery path for servos and pyro. U9 (sheet 07) is NOT sized for actuator current."
		(at 20.32 245 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 8f519bf7-2b9b-56d1-9080-75f314474fad))
	(text "Q120/Q121 AON6403 back-to-back: load switch + reverse-battery block + no back-feed from RAW_ACT."
		(at 20.32 252.62 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 59a6e5b6-56f0-507f-aad6-b28f444599c4))
	(text "Q122 turns the pair on only while RAW_PROTECTED is up, i.e. it follows the single J1.3-J1.4 switch and U9 fault latch."
		(at 20.32 260.24 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 83e74923-63dc-5d45-adcf-609d24774c6e))
	(text "USB alone: RAW_PROTECTED = 0, so RAW_ACT, the servo header and the ARM terminal are dead."
		(at 20.32 267.86 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 88d81db1-b800-5c23-b93c-6385c5a3271e))
	(text "C120 is gate-SOURCE (P0-4): a shorted C120 fails OFF. ~150 ms ride-through of contact bounce (inference, X5R bias)."
		(at 20.32 275.48 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 8c0445c0-a410-543c-84c4-63eb9f386e59))
	(text "R124/R125 10k/4.7k -> PB0: RAW_ACT sense AND bleed (tau ~7 s with C121). Mandatory external 15 A ATO fuse in battery lead."
		(at 20.32 283.1 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 130b79de-6842-5793-9be4-01e5cf6f9de4))

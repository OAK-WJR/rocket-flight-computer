	(text "PD15 / U1 pin62 is a regular FT_h GPIO input. PA9 remains NC. D+/D- are unchanged."
		(at 20.32 137.16 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 3c2f066c-5afe-5892-b82e-b7d3bdb87f81))
	(text "R9=6.2k 1%, R110=10k 0.1%; TP92 measures their junction. No internal pull-up/down."
		(at 20.32 147.32 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid f72c9822-90b2-56b1-bde1-6e667d32847e))
	(text "Input range and tolerance calculation uses DS12110 Rev11, Tables14/112 and50/147."
		(at 20.32 157.48 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 471557a9-6037-5b25-a820-f4c46731d0c0))
	(text "Use software attach/detach from PD15. Do NOT enable native PA9 VBUS sensing (VBDEN)."
		(at 20.32 167.64 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid ecfe6dc9-58a3-51ec-9f58-e8efadad67f5))
	(text "USB 48MHz source, descriptors, suspend current and actual enumeration remain unqualified."
		(at 20.32 177.8 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid a24035c6-f19e-5987-860e-1c28caf5108e))
	(text "VBUS decay depends on C28/C83/C86 and mux/switch leakage. RC estimates are conditional."
		(at 20.32 187.95999999999998 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid bc3b0792-ea13-5023-b137-dbbaec90ed46))
	(text "Measure reset/unpowered input, USB plug/unplug, discharge and hot leakage before acceptance."
		(at 20.32 198.12 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 07a246dd-bc2d-56db-aae6-5934a7bf2687))

	(text "13 | Servo outputs"
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2.54 2.54))
			(justify left))
		(uuid 0108ab5e-3506-5f47-8387-c039d56afe2f))
	(text "J122 column-major: 1/4/7/10 = SIGNAL 1-4, 2/5/8/11 = RAW_ACT (+), 3/6/9/12 = GND. HV servos only, stall <= 3 A per pin."
		(at 20.32 245 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid f326da66-07f8-5dd3-896a-ce17f27fb3aa))
	(text "Order from the MCU: 10k pull-down and SRV05-4 clamp on the MCU side, then 1.0k 0805 series (P0-5), then the header."
		(at 20.32 252.62 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 33b9c1be-7c01-5aa3-8639-b309d5f8b2fc))
	(text "PA0-PA3 = TIM5_CH1-4 (AF2). PUPDR = 00, OSPEEDR = 00, drive low at boot. TIM2 never gets a channel."
		(at 20.32 260.24 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 4cfb0c81-ee76-5da3-a91e-3355f572847b))
	(text "Quiet the servos (unloaded centre) before a pyro fire (P1-8). Two zip-tie holes straddle J122."
		(at 20.32 267.86 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 6c3bd72b-9ef1-5304-b56d-adb5d3fca376))

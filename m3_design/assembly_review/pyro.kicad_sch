	(text "12 | Pyro channels, arming and continuity"
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2.54 2.54))
			(justify left))
		(uuid 727abb5b-7667-5982-897d-07d2f9c504cb))
	(text "Two independent channels (FMEA H-5). ARM plug = 4-wire, 2-fuse link: J120.4->F1 5A FAST->J120.3 (BUS1), J120.1->F2 5A FAST->J120.2 (BUS2)."
		(at 20.32 330 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid bad85868-df48-5625-9786-5945a78f27c2))
	(text "With the plug out NOTHING connects RAW_ACT to PYRO1_BUS or PYRO2_BUS (AGENTS.md safety rule 1). No test point on BUS/OUT."
		(at 20.32 337.62 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 20f879dc-af7e-5240-9108-073154f04d2c))
	(text "Igniter 1 across J121.1-2, igniter 2 across J121.3-4. Both terminal pin orders are reversal-symmetric."
		(at 20.32 345.24 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 8ed85766-b8f6-5093-8118-1fa3f48dbd2a))
	(text "Gate: MCU -> 220R -> gate; 1k pull-down on MCU side; 10k + 220nF gate-source (P0-1/P0-2). Off in reset/unpowered."
		(at 20.32 352.86 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 2c5c599a-2813-5ee4-9d27-f9b056fe43ca))
	(text "PE3 (pin 2) and PE6 (pin 5) are sentinels with no net: firmware drives them low. Never enable TRACE on PE2-PE6."
		(at 20.32 360.48 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 23b571db-5945-56d5-ae80-b3030e357aad))
	(text "CONT = 10k/1k from drain (open detector only, CIRCUIT_REVIEW 2.9). ARMn_SENSE = 10k/1k from each fused bus."
		(at 20.32 368.1 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 3e1e8e8a-3b08-5551-a4fd-878c6260a1f4))
	(text "D120 + 47k: cold pull-up of both drains (FMEA H-1) for plug-out FET-short detection. In flight: log only, never veto (F-10)."
		(at 20.32 375.72 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left))
		(uuid 8de6969f-e2ce-515d-881e-a9dec42e2b6b))

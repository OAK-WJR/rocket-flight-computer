  "$id": "urn:r10:offline-diagnostic:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Top-level schema validates candidate messages only. Validate corpus records using $defs.public_record. Semantic identity, budget and transcript-support checks are also mandatory. No case IDs or hidden labels go to candidates.",
